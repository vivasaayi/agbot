#!/bin/sh
# agbot — one CLI for the AGBot release-and-iterate loop.
#
#   Server role (headless Linux box):
#     agbot up                    pull + run the geo_hub appliance
#     agbot upgrade [--channel C] pull a digest, restart, health-check, rollback
#     agbot down                  stop the appliance
#     agbot status                container + /health status
#     agbot logs [args...]        follow appliance logs
#
#   Mac role (developer / desktop GUIs, built locally):
#     agbot viewer                build (if needed) + run the geo_viewer desktop app
#     agbot sim [args...]         build (if needed) + run flight_sim_cpp headless
#
#   Shared:
#     agbot config [set K V]      show / set persisted settings
#     agbot channel <stable|edge> switch release channel
#     agbot version               show CLI + resolved image
#
# Persisted settings live in $AGBOT_HOME/agbot.env (default ~/.agbot).
set -eu

# --- locate repo root (this script lives in <repo>/scripts) ----------------
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

AGBOT_HOME=${AGBOT_HOME:-$HOME/.agbot}
CONFIG_FILE="$AGBOT_HOME/agbot.env"

# --- defaults (overridable via config / env) -------------------------------
DEFAULT_IMAGE_REPO="ghcr.io/vivasaayi/geo-hub"
DEFAULT_CHANNEL="stable"
DEFAULT_PORT="8080"

COMPOSE_FILE="$REPO_ROOT/docker-compose.prod.yml"

log()  { printf '\033[1;36m[agbot]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[agbot]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[agbot]\033[0m %s\n' "$*" >&2; exit 1; }

# --- persisted config ------------------------------------------------------
load_config() {
    AGBOT_IMAGE_REPO=$DEFAULT_IMAGE_REPO
    AGBOT_CHANNEL=$DEFAULT_CHANNEL
    AGBOT_PORT=$DEFAULT_PORT
    GEO_HUB_URL=${GEO_HUB_URL:-http://127.0.0.1:$DEFAULT_PORT}
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        . "$CONFIG_FILE"
    fi
    # Environment always wins over the persisted file.
    AGBOT_IMAGE_REPO=${AGBOT_IMAGE_REPO_ENV:-$AGBOT_IMAGE_REPO}
    [ -n "${AGBOT_CHANNEL_ENV:-}" ] && AGBOT_CHANNEL=$AGBOT_CHANNEL_ENV
    return 0
}

save_config() {
    mkdir -p "$AGBOT_HOME"
    cat > "$CONFIG_FILE" <<EOF
# Managed by 'agbot config' — edit with care.
AGBOT_IMAGE_REPO="$AGBOT_IMAGE_REPO"
AGBOT_CHANNEL="$AGBOT_CHANNEL"
AGBOT_PORT="$AGBOT_PORT"
GEO_HUB_URL="$GEO_HUB_URL"
EOF
    log "saved settings to $CONFIG_FILE"
}

# Resolve the image tag for the active channel. stable -> :latest, edge -> :edge.
resolved_image() {
    _tag=latest
    [ "$AGBOT_CHANNEL" = "edge" ] && _tag=edge
    printf '%s:%s' "$AGBOT_IMAGE_REPO" "$_tag"
}

active_image() {
    if [ -n "${AGBOT_IMAGE_RESOLVED:-}" ]; then
        printf '%s' "$AGBOT_IMAGE_RESOLVED"
    else
        resolved_image
    fi
}

# --- docker helpers --------------------------------------------------------
need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is required but not installed"
}

compose() {
    # Prefer the compose plugin; fall back to docker-compose.
    if docker compose version >/dev/null 2>&1; then
        AGBOT_IMAGE="$(active_image)" AGBOT_PORT="$AGBOT_PORT" \
            docker compose -f "$COMPOSE_FILE" "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        AGBOT_IMAGE="$(active_image)" AGBOT_PORT="$AGBOT_PORT" \
            docker-compose -f "$COMPOSE_FILE" "$@"
    else
        die "neither 'docker compose' nor 'docker-compose' is available"
    fi
}

pin_pulled_image() {
    image_ref="$(resolved_image)"
    image_digest="$(docker image inspect \
        --format '{{index .RepoDigests 0}}' "$image_ref" 2>/dev/null || true)"
    [ -n "$image_digest" ] && [ "$image_digest" != "<no value>" ] \
        || die "could not resolve immutable digest for $image_ref"
    AGBOT_IMAGE_RESOLVED="$image_digest"
    log "resolved $image_ref to $AGBOT_IMAGE_RESOLVED"
}

running_image() {
    container_image_id="$(docker inspect --format '{{.Image}}' agbot-geo-hub 2>/dev/null || true)"
    [ -n "$container_image_id" ] || return 0
    docker image inspect --format '{{index .RepoDigests 0}}' \
        "$container_image_id" 2>/dev/null || printf '%s' "$container_image_id"
}

wait_for_health() {
    health_url="http://127.0.0.1:$AGBOT_PORT/health"
    attempt=1
    while [ "$attempt" -le 30 ]; do
        if command -v curl >/dev/null 2>&1 && \
            curl -fsS "$health_url" >/dev/null 2>&1; then
            log "health OK at $health_url"
            return 0
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    warn "health check did not recover at $health_url"
    return 1
}

# --- server commands -------------------------------------------------------
cmd_up() {
    need_docker
    [ -f "$COMPOSE_FILE" ] || die "compose file not found: $COMPOSE_FILE"
    log "pulling $(resolved_image)"
    compose pull
    pin_pulled_image
    log "starting geo_hub appliance on port $AGBOT_PORT"
    compose up -d
    wait_for_health
}

cmd_upgrade() {
    need_docker
    previous_image="$(running_image)"
    log "upgrading to newest $AGBOT_CHANNEL image: $(resolved_image)"
    compose pull
    pin_pulled_image
    # Recreate only the service; named volumes (db/data) are preserved.
    compose up -d
    if wait_for_health; then
        log "upgrade complete; data volumes preserved"
        return 0
    fi

    if [ -n "$previous_image" ]; then
        warn "upgrade failed health checks; rolling back to $previous_image"
        AGBOT_IMAGE_RESOLVED="$previous_image"
        compose up -d
        if wait_for_health; then
            warn "rollback completed; the new digest was not promoted"
        else
            die "rollback failed health checks; inspect logs with 'agbot logs'"
        fi
    fi
    die "upgrade failed health checks; the previous appliance remains active"
}

cmd_down() {
    need_docker
    compose down
    log "appliance stopped (volumes retained)"
}

cmd_status() {
    need_docker
    compose ps || true
    wait_for_health
}

cmd_logs() {
    need_docker
    compose logs -f "$@"
}

# --- mac / desktop commands ------------------------------------------------
have_just() { command -v just >/dev/null 2>&1; }

cmd_viewer() {
    have_just || die "'just' is required to build the desktop viewer"
    log "building + launching geo_viewer against GEO_HUB_URL=$GEO_HUB_URL"
    GEO_HUB_URL="$GEO_HUB_URL" just -f "$REPO_ROOT/justfile" viewer "$@"
}

cmd_sim() {
    have_just || die "'just' is required to build the flight simulator"
    log "building + launching flight_sim_cpp (headless)"
    just -f "$REPO_ROOT/justfile" sim "$@"
}

# --- config / meta ---------------------------------------------------------
cmd_config() {
    if [ "$#" -eq 0 ]; then
        printf 'image_repo = %s\n' "$AGBOT_IMAGE_REPO"
        printf 'channel    = %s\n' "$AGBOT_CHANNEL"
        printf 'port       = %s\n' "$AGBOT_PORT"
        printf 'geo_hub_url= %s\n' "$GEO_HUB_URL"
        printf 'image      = %s\n' "$(resolved_image)"
        printf 'config     = %s\n' "$CONFIG_FILE"
        return 0
    fi
    [ "$1" = "set" ] || die "usage: agbot config [set <key> <value>]"
    shift
    [ "$#" -eq 2 ] || die "usage: agbot config set <key> <value>"
    case "$1" in
        image_repo)  AGBOT_IMAGE_REPO=$2 ;;
        channel)     AGBOT_CHANNEL=$2 ;;
        port)        AGBOT_PORT=$2 ;;
        geo_hub_url) GEO_HUB_URL=$2 ;;
        *) die "unknown key: $1 (image_repo|channel|port|geo_hub_url)" ;;
    esac
    save_config
}

cmd_channel() {
    [ "$#" -eq 1 ] || die "usage: agbot channel <stable|edge>"
    case "$1" in
        stable|edge) AGBOT_CHANNEL=$1 ;;
        *) die "channel must be 'stable' or 'edge'" ;;
    esac
    save_config
    log "channel set to $AGBOT_CHANNEL ($(resolved_image))"
}

cmd_version() {
    printf 'agbot CLI (repo %s)\n' "$REPO_ROOT"
    printf 'channel: %s\n' "$AGBOT_CHANNEL"
    printf 'image:   %s\n' "$(resolved_image)"
}

usage() {
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
}

# --- dispatch --------------------------------------------------------------
main() {
    load_config
    [ "$#" -ge 1 ] || { usage; exit 0; }
    cmd=$1; shift

    # Allow --channel to precede channel-sensitive commands.
    case "$cmd" in
        up|upgrade|down|status|logs)
            while [ "$#" -ge 1 ]; do
                case "$1" in
                    --channel) [ "$#" -ge 2 ] || die "--channel needs a value"; AGBOT_CHANNEL=$2; shift 2 ;;
                    *) break ;;
                esac
            done
            ;;
    esac

    case "$cmd" in
        up)       cmd_up "$@" ;;
        upgrade)  cmd_upgrade "$@" ;;
        down)     cmd_down "$@" ;;
        status)   cmd_status "$@" ;;
        logs)     cmd_logs "$@" ;;
        viewer)   cmd_viewer "$@" ;;
        sim)      cmd_sim "$@" ;;
        config)   cmd_config "$@" ;;
        channel)  cmd_channel "$@" ;;
        version)  cmd_version "$@" ;;
        help|-h|--help) usage ;;
        *) die "unknown command: $cmd (try 'agbot help')" ;;
    esac
}

main "$@"
